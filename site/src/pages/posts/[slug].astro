---
import Layout from '../../layouts/Layout.astro';
import posts from '../../../../.generated/posts.json';
export function getStaticPaths() {
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<Layout title={post.title}>
  <link slot="head" rel="preload" href="/fonts/LibertinusSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
  {post.body.includes('<math') && <link slot="head" rel="preload" href="/fonts/NewCMMath-Book.woff2" as="font" type="font/woff2" crossorigin />}
  <Fragment slot="head" set:html={post.styles} />
  <article>
    <header class="article-header">
      <div class="article-meta">
        <a class="back-link" href="/">← 返回首页</a>
        <span><time datetime={post.date}>{post.date.replaceAll('-', '.')}</time> · {post.category}</span>
      </div>
      <h1>{post.title}</h1>
    </header>
    <div class="prose" set:html={post.body} />
  </article>
</Layout>
