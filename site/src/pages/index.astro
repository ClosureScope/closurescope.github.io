---
import posts from '../../../.generated/posts.json';
const index = posts.map(({ slug, title, category }) => ({ slug, title, category }));
const json = JSON.stringify(index).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e8e5e1" />
    <meta name="description" content="ClosureScope 的博客。" />
    <title>ClosureScope · Directory</title>
  </head>
  <body>
    <main id="viewport">
      <div id="stage"></div>
      <section id="empty-archive" hidden><h1>ClosureScope</h1><p>暂无文章。</p></section>
    </main>
    <script id="blog-index" type="application/json" set:html={json} />
    <script>
      import '../rhine/entry';
    </script>
    <noscript><h1>ClosureScope</h1><p>三维文章界面需要 JavaScript。你也可以直接阅读文章：</p><ul>{posts.map(post => <li><a href={`/posts/${post.slug}/`}>{post.title}</a></li>)}</ul></noscript>
  </body>
</html>
