---
import '../styles/global.css';
const { title = '技术手记', description = 'ClosureScope 的博客。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === '技术手记' ? title : `${title} · 技术手记`}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/">技术手记<span class="brand-dot">.</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">ClosureScope</footer>
  </body>
</html>
