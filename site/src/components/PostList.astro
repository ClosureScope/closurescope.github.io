---
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map(post => (
    <li>
      <time datetime={post.date}>{post.date.replaceAll('-', '.')}</time>
      <div>
        <h3><a href={`/posts/${post.slug}/`}>{post.title}</a></h3>
        <p>{post.description}</p>
      </div>
    </li>
  ))}
</ol>
