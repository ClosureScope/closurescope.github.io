---
import '../styles/global.css';
const { title = 'ClosureScope', description = 'ClosureScope 的博客。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'ClosureScope' ? title : `${title} · ClosureScope`}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/">ClosureScope<span class="brand-dot">.</span></a>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
