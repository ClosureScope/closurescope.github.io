---
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map(post => (
    <li>
      <time datetime={post.date}>{post.date.replaceAll('-', '.')}</time>
      <div>
        <h2><a href={`/posts/${post.slug}/`}>{post.title}</a></h2>
        <p>{post.description}</p>
      </div>
      <span class="post-arrow" aria-hidden="true">↗</span>
    </li>
  ))}
</ol>
